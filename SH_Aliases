# All
alias dc_up_all='doppler run -- docker compose -f docker-compose.yml -f docker-compose.blue.yml -f docker-compose.green.yml up -d'
alias dc_down_all='doppler run -- docker compose -f docker-compose.yml -f docker-compose.blue.yml -f docker-compose.green.yml down'
alias dc_logs_all='doppler run -- docker compose -f docker-compose.yml -f docker-compose.blue.yml -f docker-compose.green.yml logs -f --tail=10'
alias dc_ps_all='doppler run -- docker compose -f docker-compose.yml -f docker-compose.blue.yml -f docker-compose.green.yml ps'

# Traefik only
alias dc_up_traefik='doppler run -- docker compose -f docker-compose.yml up -d'
alias dc_down_traefik='doppler run -- docker compose -f docker-compose.yml down'
alias dc_logs_traefik='doppler run -- docker compose -f docker-compose.yml logs -f --tail=10'

# Blue only
alias dc_up_blue='doppler run -- docker compose -f docker-compose.blue.yml up -d'
alias dc_down_blue='doppler run -- docker compose -f docker-compose.blue.yml down'
alias dc_logs_blue='doppler run -- docker compose -f docker-compose.blue.yml logs -f --tail=10'

# Green only
alias dc_up_green='doppler run -- docker compose -f docker-compose.green.yml up -d'
alias dc_down_green='doppler run -- docker compose -f docker-compose.green.yml down'
alias dc_logs_green='doppler run -- docker compose -f docker-compose.green.yml logs -f --tail=10'