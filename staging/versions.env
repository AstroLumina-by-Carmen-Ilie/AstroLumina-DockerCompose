# =============================================================================
# Image tags — SOURCE OF TRUTH in git (not secrets, safe to commit).
# Coexists with Doppler: these 4 vars must NOT exist in Doppler,
# otherwise the Doppler values silently win (process env > .env file
# in compose interpolation). Fill in once from Doppler, then delete
# them from the Doppler config.
# Local flow (compose `image:` is interpolated from process env,
# service-level env_file would be too late):
#   set -a; source versions.env; set +a
#   doppler run -- docker compose -f docker-compose.yml -f docker-compose.blue.yml -f docker-compose.green.yml up -d
# Server flow: the manual deploy.yml workflow bumps the idle-color tag AND
# flips the router to it here in git (branch + PR); after merge, apply on the
# host with compose pull + up -d -- traffic switches on apply.
# =============================================================================
# Tags are PER COLOR (true blue-green): each color pins its own version.
# Same value on both colors = current behavior; the deploy workflow bumps
# idle and flips live in one PR.

# Blue
FRONTEND_BLUE_DOCKER_IMAGE_TAG=2.0.10
ASTROLOGY_API_BLUE_DOCKER_IMAGE_TAG=2.0.11
BOOKING_API_BLUE_DOCKER_IMAGE_TAG=2.0.9
PAYMENT_API_BLUE_DOCKER_IMAGE_TAG=2.0.10

# Green
FRONTEND_GREEN_DOCKER_IMAGE_TAG=2.0.9
ASTROLOGY_API_GREEN_DOCKER_IMAGE_TAG=2.0.12
BOOKING_API_GREEN_DOCKER_IMAGE_TAG=2.0.8
PAYMENT_API_GREEN_DOCKER_IMAGE_TAG=2.0.9
