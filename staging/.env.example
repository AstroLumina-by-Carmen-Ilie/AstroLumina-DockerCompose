# =============================================================================
# AstroLumina Environment Variables — STAGING
# Copy as .env and fill in the values. Template: development/.env.example
# Blue-green: the LIVE color is switched in traefik/dynamic/routes.yml,
# not via .env. Image tags may differ per color if needed,
# but in the simple scenario they are the same.
# =============================================================================
NODE_ENV=staging
GITHUB_TOKEN=...
GITHUB_USER=...
# echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USER --password-stdin
FRONTEND_DOCKER_IMAGE_TAG=...
ASTROLOGY_API_DOCKER_IMAGE_TAG=...
BOOKING_API_DOCKER_IMAGE_TAG=...
PAYMENT_API_DOCKER_IMAGE_TAG=...
# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_SERVER_PORT=...
FRONTEND_SERVER_DNS=...
FRONTEND_SENTRY_DSN=...
# ─────────────────────────────────────────────────────────────────────────────
# Public API URLs (frontend -> Traefik routers). MUST be absolute URLs
# with scheme (no TLS on staging, so http://), e.g.:
# ASTROLOGICAL_API_TRAEFIK_URL=http://staging.dc.astrolumina.ro/api/astrology
# Without the scheme the browser resolves them as relative paths and
# API calls break.
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGICAL_API_TRAEFIK_URL=...
BOOKING_API_TRAEFIK_URL=...
PAYMENT_API_TRAEFIK_URL=...
# ─────────────────────────────────────────────────────────────────────────────
# AstrologyAPI
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGY_API_SERVER_PORT=...
ASTROLOGY_API_SERVER_DNS=...
ASTROLOGY_API_SENTRY_DSN=...
ASTROLOGICAL_API_URL=...
ASTROLOGER_API_HOST=...
ASTROLOGER_API_KEY=...
ASTROLOGER_API_URL=...
# ─────────────────────────────────────────────────────────────────────────────
# BookingAPI
# ─────────────────────────────────────────────────────────────────────────────
BOOKING_API_SERVER_PORT=...
BOOKING_API_SERVER_DNS=...
BOOKING_API_SENTRY_DSN=...
BOOKING_API_URL=...
CALCOM_BASE_URL=...
CALCOM_API_KEY=...
RESEND_API_KEY=...
R2_BASE_URL=...
D1_ACCOUNT_ID=...
D1_DATABASE_ID=...
D1_API_TOKEN=...
# ─────────────────────────────────────────────────────────────────────────────
# PaymentAPI
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_API_SERVER_PORT=...
PAYMENT_API_SERVER_DNS=...
PAYMENT_API_SENTRY_DSN=...
PAYMENT_API_URL=...
STRIPE_API_VER=...
STRIPE_SK=...
STRIPE_PK=...
STRIPE_SOARELE_STRALUCIREA_TA=...
STRIPE_GHID_SATURN_IN_BERBEC=...
STRIPE_ASTROGRAMA_NATALA_SI_KARMICA=...
STRIPE_ASTROGRAMA_RELATIONALA=...
STRIPE_ASTROGRAMA_PREVIZIONALA=...
STRIPE_EVENIMENT_CONSTELATII=...
# ─────────────────────────────────────────────────────────────────────────────
