# =============================================================================
# AstroLumina Environment Variables
# Copiază acest fișier ca .env și completează valorile
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# AstroLumina Frontend
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost/api

# ─────────────────────────────────────────────────────────────────────────────
# AstrologyAPI
# Obține de la https://rapidapi.com/
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGER_API_KEY=your_rapidapi_key_here
ASTROLOGER_API_URL=https://astrology-api.p.rapidapi.com

# ─────────────────────────────────────────────────────────────────────────────
# BookingAPI
# Obține de la https://app.cal.com/settings/developer
# ─────────────────────────────────────────────────────────────────────────────
CALCOM_API_KEY=your_calcom_api_key_here

# Resend API pentru email (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# PaymentAPI
# Obține de la https://dashboard.stripe.com/test/apikeys
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SK=sk_test_your_secret_key_here
STRIPE_PK=pk_test_your_publishable_key_here

# Price IDs din Stripe Dashboard
STRIPE_NATAL_CHART_PRICE=price_your_natal_chart_price_id
STRIPE_KARMIC_CHART_PRICE=price_your_karmic_chart_price_id
STRIPE_BOOKING_PRICE=price_your_booking_price_id

# ─────────────────────────────────────────────────────────────────────────────
# Sentry Monitoring
# Obține de la https://sentry.io/settings/astrolumina/
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here

GITHUB_TOKEN=your_github_token_here
GITHUB_USER=your_github_username_here
# echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USER --password-stdin